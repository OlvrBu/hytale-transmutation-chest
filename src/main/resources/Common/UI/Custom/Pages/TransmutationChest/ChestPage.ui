$C = "../../Common.ui";

// Transmutation Chest page, laid out like the vanilla workbench: icon tabs above the window, a breadcrumb
// title row ("Transmutation Chest > Buy") with group tabs (Buy) and an expanding search, then the list.
// The server fills the texts and appends rows (ChestSellRow/ChestUnlockRow.ui) or a grid of
// ChestCell.ui squares (Buy, unlock details) into #Rows.

$C.@PageOverlay {}

Group #Window {
  Anchor: (Width: 920, Height: 690);
  LayoutMode: Top;

  // Tabs on top of the window (built-in TabNavigation; the server is told via SelectedTabChanged).
  TabNavigation #Tabs {
    Anchor: (Height: 66, Left: 2, Right: 0);
    Style: $C.@TopTabsStyle;
    SelectedTab: "Buy";

    TabButton {
      Icon: "BuyIcon.png";
      TooltipText: %transmutationchest.ui.tabBuy;
      Id: "Buy";
    }

    TabButton {
      Icon: "SellIcon.png";
      TooltipText: %transmutationchest.ui.tabSell;
      Id: "Sell";
    }

    TabButton {
      Icon: "UnlockIcon.png";
      TooltipText: %transmutationchest.ui.tabUnlock;
      Id: "Unlock";
    }
  }

  $C.@Container {
    FlexWeight: 1;

    #Title {
      Group {
        LayoutMode: Left;
        Anchor: (Full: 0);
        Padding: (Left: 19, Right: 6);

        // Breadcrumb: "TRANSMUTATION CHEST > SELL"
        Label #Crumb {
          Style: (...$C.@TitleStyle, TextColor: $C.@ColorGrayCaption);
          Text: %transmutationchest.ui.title;
        }

        Label #CrumbSeparator {
          Padding: (Horizontal: 8);
          Style: (...$C.@TitleStyle, TextColor: $C.@ColorGrayCaption);
          Text: ">";
        }

        Label #TabTitle {
          Style: $C.@TitleStyle;
          Text: "";
        }

        Group {
          FlexWeight: 1;
        }

        // Buy tab only (the server toggles visibility): item groups as small icon tabs, like the
        // workbench's header tabs. Ids match BuyGroup in the code.
        TabNavigation #Groups {
          Anchor: (Height: 34, Right: 8);
          Style: $C.@HeaderTabsStyle;
          SelectedTab: "Recents";
          Visible: false;

          TabButton {
            Icon: "GroupRecent.png";
            TooltipText: %transmutationchest.ui.groupRecents;
            Id: "Recents";
          }

          TabButton {
            Icon: "GroupRocks.png";
            TooltipText: %transmutationchest.ui.groupRocks;
            Id: "Rocks";
          }

          TabButton {
            Icon: "GroupWood.png";
            TooltipText: %transmutationchest.ui.groupWood;
            Id: "Wood";
          }

          TabButton {
            Icon: "GroupSoil.png";
            TooltipText: %transmutationchest.ui.groupSoil;
            Id: "Soil";
          }

          TabButton {
            Icon: "GroupFurniture.png";
            TooltipText: %transmutationchest.ui.groupFurniture;
            Id: "Furniture";
          }

          TabButton {
            Icon: "GroupOther.png";
            TooltipText: %transmutationchest.ui.groupOther;
            Id: "Other";
          }
        }

        // Magnifying glass that expands into a search field (contains #SearchInput).
        // Each tab keeps its own search text (the server swaps it in on tab change).
        $C.@HeaderSearch #Search {}

      }
    }

    #Content {
      LayoutMode: Top;

      // Balance and the result of the last trade.
      Group #InfoBar {
        Anchor: (Height: 36, Bottom: 6);
        LayoutMode: Left;
        Padding: (Horizontal: 8);

        // Details view of an unlock only: back to the unlock list.
        $C.@SmallSecondaryTextButton #InspectBack {
          Anchor: (Width: 110, Height: $C.@SmallButtonHeight, Right: 12);
          Text: %transmutationchest.ui.back;
          Visible: false;
        }

        Label #Balance {
          FlexWeight: 1;
          Style: (FontSize: 20, TextColor: #E8A93B, RenderBold: true, VerticalAlignment: Center);
          Text: "";
        }

        Label #Status {
          FlexWeight: 2;
          Style: (FontSize: 14, TextColor: #96a9be, HorizontalAlignment: End, VerticalAlignment: Center);
          Text: "";
        }
      }

      $C.@ContentSeparator {}

      Label #NoMatches {
        Anchor: (Height: 40);
        Style: (FontSize: 15, TextColor: #878e9c, HorizontalAlignment: Center, VerticalAlignment: Center);
        Text: "";
        Visible: false;
      }

      // Rows are appended directly into the scrolling group, so the server can scroll it back to the
      // top with ScrollChildIndexIntoView = 0.
      Group #Rows {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Top: 8, Right: 8);
      }

      // Pager: the server sends one page of rows at a time.
      Group #Pager {
        Anchor: (Height: 44, Top: 6);
        LayoutMode: Left;
        Padding: (Horizontal: 8);

        $C.@SmallSecondaryTextButton #PrevPage {
          Anchor: (Width: 130, Height: $C.@SmallButtonHeight);
          Text: %transmutationchest.ui.prevPage;
        }

        Label #PageLabel {
          FlexWeight: 1;
          Style: (FontSize: 14, TextColor: #96a9be, HorizontalAlignment: Center, VerticalAlignment: Center);
          Text: "";
        }

        $C.@SmallSecondaryTextButton #NextPage {
          Anchor: (Width: 130, Height: $C.@SmallButtonHeight);
          Text: %transmutationchest.ui.nextPage;
        }
      }
    }
  }
}

$C.@BackButton {}
